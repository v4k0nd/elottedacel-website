---
import LocaleToggle from './LocaleToggle.astro';

interface Props {
  lang?: 'hu' | 'ro';
  localeToggle?: { huUrl: string; roUrl: string };
}

const { lang = 'hu', localeToggle } = Astro.props;

const huNav = [
  { href: '/', label: 'Kezdőlap' },
  { href: '/rolunk', label: 'Rólunk' },
  { href: '/tevekenysegeink', label: 'Tevékenységeink' },
  { href: '/futocsapat', label: 'Futócsapat' },
  { href: '/hirek', label: 'Hírek' },
  { href: '/tamogatas', label: 'Támogass' },
];

const roNav = [
  { href: '/ro/rolunk', label: 'Despre noi' },
  { href: '/ro/tevekenysegeink', label: 'Activități' },
  { href: '/ro/tamogatas', label: 'Susține-ne' },
];

const navItems = lang === 'ro' ? roNav : huNav;
const homeHref = lang === 'ro' ? '/ro/rolunk' : '/';
const currentPath = Astro.url.pathname;

const mainNavLabel = lang === 'ro' ? 'Navigare principală' : 'Főmenü';
const openLabel   = lang === 'ro' ? 'Deschide meniul' : 'Menü megnyitása';
const closeLabel  = lang === 'ro' ? 'Închide meniul'  : 'Menü bezárása';
---

<header class="border-b border-line bg-cream sticky top-0 z-40">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <!-- TODO: replace text with actual SVG logo once provided -->
      <a
        href={homeHref}
        class="font-display text-lg font-bold text-ink hover:text-orange-500 transition-colors"
      >
        Előtted a Cél
      </a>

      <!-- Desktop nav (hidden on mobile) -->
      <nav class="hidden md:block" aria-label={mainNavLabel}>
        <ul class="flex items-center gap-6 text-sm font-medium">
          {navItems.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class:list={[
                  'transition-colors',
                  currentPath === href
                    ? 'text-orange-500'
                    : 'text-ink-soft hover:text-orange-500',
                ]}
                aria-current={currentPath === href ? 'page' : undefined}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Right side: desktop locale toggle + hamburger button -->
      <div class="flex items-center gap-3">
        {localeToggle && (
          <div class="hidden md:flex">
            <LocaleToggle
              huUrl={localeToggle.huUrl}
              roUrl={localeToggle.roUrl}
              currentLang={lang}
            />
          </div>
        )}

        <!-- Hamburger / close button — mobile only -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="md:hidden p-2 rounded text-ink-soft hover:text-orange-500 transition-colors"
          aria-label={openLabel}
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-open-label={openLabel}
          data-close-label={closeLabel}
        >
          <!-- Hamburger (shown when closed) -->
          <svg
            id="icon-hamburger"
            xmlns="http://www.w3.org/2000/svg"
            width="22" height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="4" y1="6"  x2="20" y2="6"  />
            <line x1="4" y1="12" x2="20" y2="12" />
            <line x1="4" y1="18" x2="20" y2="18" />
          </svg>
          <!-- X (shown when open) -->
          <svg
            id="icon-close"
            xmlns="http://www.w3.org/2000/svg"
            width="22" height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="hidden"
          >
            <line x1="18" y1="6"  x2="6"  y2="18" />
            <line x1="6"  y1="6"  x2="18" y2="18" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile menu panel — hidden by default; md:hidden keeps it off on desktop even if JS opens it -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-line bg-cream"
  >
    <nav aria-label={mainNavLabel}>
      <ul class="px-4 pt-3 pb-2 space-y-1 text-sm font-medium">
        {navItems.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class:list={[
                'block px-3 py-2 rounded transition-colors',
                currentPath === href
                  ? 'text-orange-500 bg-orange-500/10'
                  : 'text-ink-soft hover:text-orange-500 hover:bg-orange-500/5',
              ]}
              aria-current={currentPath === href ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {localeToggle && (
      <div class="px-7 py-3 border-t border-line">
        <LocaleToggle
          huUrl={localeToggle.huUrl}
          roUrl={localeToggle.roUrl}
          currentLang={lang}
        />
      </div>
    )}
  </div>
</header>

<script>
  const btn  = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconHamburger = document.getElementById('icon-hamburger');
  const iconClose     = document.getElementById('icon-close');

  const openLabel  = btn?.dataset.openLabel  ?? '';
  const closeLabel = btn?.dataset.closeLabel ?? '';

  function setOpen(open: boolean) {
    menu?.classList.toggle('hidden', !open);
    btn?.setAttribute('aria-expanded', String(open));
    btn?.setAttribute('aria-label', open ? closeLabel : openLabel);
    iconHamburger?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  }

  btn?.addEventListener('click', () => {
    setOpen(menu?.classList.contains('hidden') ?? true);
  });

  // Close when any nav link inside the menu is tapped
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });
</script>
