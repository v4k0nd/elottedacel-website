---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SponsorWall from '../components/SponsorWall.astro';

const allNews = await getCollection('news');
const recentNews = allNews
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const pillarColors: Record<string, string> = {
  sport: '#F97316',
  zene: '#A855F7',
  kultura: '#EF4444',
  segitseg: '#1E3A8A',
  kozosseg: '#65A30D',
};

const stats = [
  { number: '5 604 km', label: 'lefutott táv 2025-ben' },
  { number: '35 verseny', label: '2025-ben' },
  { number: '63 gyermek', label: 'a gitártáborban' },
  { number: '42 gyermek', label: 'a hangszertanuláson' },
];
---

<Layout
  title="Előtted a Cél Egyesület"
  description="Testet erősítünk, lelket emelünk, közösséget építünk. Nyárádszeredai nonprofit, amely segítségnyújtásban, zenében, sportban és kultúrában tevékenykedik."
  localeToggle={{ huUrl: '/', roUrl: '/ro/' }}
>

  <!-- ─── Hero ──────────────────────────────────────────────── -->
  <div class="w-full">
    <img
      src="/img/hero-rolunk.jpg"
      alt="Előtted a Cél Egyesület közössége"
      loading="eager"
      class="w-full max-h-[480px] object-cover"
    />
  </div>

  <div class="max-w-2xl mx-auto px-4 pt-12 pb-6 text-center">
    <h1 class="font-display text-4xl sm:text-5xl text-ink leading-tight mb-3">
      Előtted a Cél Egyesület
    </h1>
    <p class="font-display italic text-xl sm:text-2xl text-ink-soft mb-6">
      Testet erősítünk, lelket emelünk, közösséget építünk!
    </p>
    <p class="text-ink-soft leading-relaxed mb-8 max-w-xl mx-auto">
      Egy közösség Nyárádszeredából, ahol a mozgás, a zene, a tudás és a segítségnyújtás kéz a kézben jár. Több területen is aktívan támogatjuk a közösséget — testi, lelki és szellemi szinten egyaránt.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <a
        href="/tevekenysegeink"
        class="bg-orange-500 text-white px-6 py-3 rounded font-medium hover:bg-orange-600 transition-colors"
      >
        Tevékenységeink →
      </a>
      <a
        href="/tamogatas"
        class="border-2 text-orange-500 px-6 py-3 rounded font-medium hover:bg-orange-500 hover:text-white transition-colors"
        style="border-color: #E8590C;"
      >
        Támogass minket →
      </a>
    </div>
  </div>

  <!-- ─── Stats strip ───────────────────────────────────────── -->
  <section class="border-y border-line mt-16 sm:mt-20" aria-label="Számokban">
    <div class="max-w-4xl mx-auto grid grid-cols-2 md:grid-cols-4 px-4 sm:px-6 md:px-0">
      {stats.map((s, i) => (
        <div
          class:list={[
            'py-8 text-center',
            i < 3 && 'md:border-r md:border-line',
          ]}
        >
          <p class="font-display text-2xl lg:text-3xl xl:text-4xl font-bold text-ink leading-none mb-2 whitespace-nowrap">
            {s.number}
          </p>
          <p class="text-sm text-ink-soft">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ─── Recent news ───────────────────────────────────────── -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 mt-16 sm:mt-24">
    <h2 class="font-display text-3xl text-ink mb-8">Legutóbbi hírek</h2>

    {recentNews.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {recentNews.map((post) => {
          const coverPhoto = post.data.heroImage ?? post.data.photos[0];
          const accentColor = pillarColors[post.data.pillar] ?? '#E8E4DC';
          const formattedDate = post.data.date.toLocaleDateString('hu-HU', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          });
          return (
            <a
              href={`/hirek/${post.id}`}
              class="group flex flex-col border border-line rounded-lg overflow-hidden hover:-translate-y-1 transition-transform duration-200 hover:border-orange-500"
            >
              {coverPhoto ? (
                <img
                  src={coverPhoto}
                  alt={post.data.title}
                  loading="lazy"
                  class="w-full h-44 object-cover"
                />
              ) : (
                <div class="w-full h-44" style={`background-color: ${accentColor};`} aria-hidden="true" />
              )}
              <div class="p-5 flex flex-col flex-grow">
                <p class="text-xs text-ink-soft uppercase tracking-wide mb-2">{formattedDate}</p>
                <h3 class="font-display text-xl text-ink mb-2 group-hover:text-orange-500 transition-colors leading-snug">
                  {post.data.title}
                </h3>
                {post.data.excerpt && (
                  <p class="text-ink-soft text-sm leading-relaxed">{post.data.excerpt}</p>
                )}
              </div>
            </a>
          );
        })}
      </div>
    ) : (
      <p class="text-ink-soft">Hamarosan hírek is érkeznek — kövess minket Facebookon!</p>
    )}

    <div class="text-center mt-10">
      <a href="/hirek" class="font-medium hover:underline" style="color: #E8590C;">
        Összes hír →
      </a>
    </div>
  </section>

  <!-- ─── Sponsor wall ───────────────────────────────────────── -->
  <SponsorWall />

  <!-- ─── Facebook follow card ─────────────────────────────── -->
  <section class="border-t border-line mt-16 sm:mt-24 py-16 px-4">
    <div class="max-w-xl mx-auto text-center">
      <h2 class="font-display text-3xl text-ink mb-4">Kövess minket Facebookon</h2>
      <p class="text-ink-soft mb-8 leading-relaxed">
        Friss híreink, fotók eseményeinkről és napi pillanatok a közösségünkből.
      </p>
      <a
        href="https://facebook.com/elotted.a.cel"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-orange-500 text-white px-8 py-3 rounded font-medium hover:bg-orange-600 transition-colors"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
        </svg>
        Asociația Előtted a cél
      </a>
    </div>
  </section>

</Layout>
