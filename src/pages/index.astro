---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Előtted a Cél Egyesület"
  description="Testet erősítünk, lelket emelünk, közösséget építünk. Nyárádszeredai nonprofit, amely segítségnyújtásban, zenében, sportban és kultúrában tevékenykedik."
  localeToggle={{ huUrl: '/', roUrl: '/ro/' }}
>
  <div class="max-w-2xl mx-auto px-4 py-16">
    <h1 class="font-display text-4xl md:text-5xl text-ink mb-4">
      Előtted a Cél Egyesület
    </h1>
    <p class="text-lg text-ink-soft mb-8">
      Testet erősítünk, lelket emelünk, közösséget építünk!
    </p>
    <p class="text-ink-soft">
      Lorem ipsum — Hero, PillarGrid, StatsStrip, NewsList, RecurringEvents hamarosan.
    </p>

    <!-- Diacritic render test (visible in dev, can be removed before launch) -->
    <p class="mt-12 text-xs text-ink-soft font-body">
      Font test — body (Inter): ő ű á é í ó ú Ő Ű Á É Í Ó Ú
    </p>
    <p class="text-xs text-ink-soft font-display">
      Font test — display (Fraunces): ő ű á é í ó ú Ő Ű Á É Í Ó Ú
    </p>
  </div>
</Layout>
