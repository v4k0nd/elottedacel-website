---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Asociația Előtted a Cél"
  description="Asociația Előtted a Cél din Miercurea Nirajului, jud. Mureș."
  lang="ro"
  localeToggle={{ huUrl: '/', roUrl: '/ro/' }}
>
  <div class="max-w-2xl mx-auto px-4 py-16" lang="ro">
    <h1 class="font-display text-4xl text-ink mb-4">Előtted a Cél</h1>
    <p class="text-ink-soft mb-6">
      Conținutul în limba română va fi disponibil în curând. Vizitați paginile de mai jos:
    </p>
    <ul class="space-y-2 text-sm">
      <li>
        <a href="/ro/rolunk" class="text-orange-500 hover:text-orange-600 transition-colors">
          Despre noi
        </a>
      </li>
      <li>
        <a href="/ro/tevekenysegeink" class="text-orange-500 hover:text-orange-600 transition-colors">
          Activitățile noastre
        </a>
      </li>
      <li>
        <a href="/ro/tamogatas" class="text-orange-500 hover:text-orange-600 transition-colors">
          Susține-ne
        </a>
      </li>
    </ul>
  </div>
</Layout>
