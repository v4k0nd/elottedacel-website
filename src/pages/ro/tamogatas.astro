---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Susține-ne — Asociația Előtted a Cél"
  description="Susține Asociația Előtted a Cél prin redirecționarea a 3,5% din impozit, transfer bancar sau voluntariat."
  lang="ro"
  localeToggle={{ huUrl: '/tamogatas', roUrl: '/ro/tamogatas' }}
>
  <div class="max-w-2xl mx-auto px-4 py-16" lang="ro">
    <h1 class="font-display text-4xl text-ink mb-4">Susține-ne</h1>
    <p class="text-ink-soft">
      Lorem ipsum — Conținut în curând: procesul 3,5%, IBAN, voluntariat, formular de contact.
    </p>
    <div id="harom-ot" class="mt-12">
      <h2 class="font-display text-2xl text-ink mb-2">Redirecționarea a 3,5%</h2>
      <p class="text-ink-soft">
        În curând — Descarci → Completezi → Depui.
      </p>
      <a
        href="https://formular230.ro/elotted-a-cel"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block mt-4 bg-orange-500 text-white px-6 py-3 rounded hover:bg-orange-600 transition-colors font-medium"
      >
        Completează Formularul 230
      </a>
    </div>
  </div>
</Layout>
